<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Acción de ventana - SOLO ADMINISTRADOR -->
    <record id="action_reporte_configuracion" model="ir.actions.act_window">
        <field name="name">Configuración</field>
        <field name="res_model">reporte.config</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
        <field name="groups_id" eval="[(4, ref('reportes_modulo.group_reporte_administrador'))]"/>
    </record>

    <!-- Vista Tree -->
    <record id="view_reporte_config_tree" model="ir.ui.view">
        <field name="name">reporte.config.tree</field>
        <field name="model">reporte.config</field>
        <field name="arch" type="xml">
            <tree string="Configuración de Roles">
                <field name="usuario_id"/>
                <field name="rol" widget="badge"/>
                <field name="area_ids" widget="many2many_tags"/>
                <field name="activo"/>
            </tree>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_reporte_config_form" model="ir.ui.view">
        <field name="name">reporte.config.form</field>
        <field name="model">reporte.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de Reportes">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Nota:</strong> Esta sección está reservada para futuras funcionalidades.
                    </div>

                    <group>
                        <group>
                            <field name="usuario_id"/>
                            <field name="rol"/>
                        </group>
                        <group>
                            <field name="area_ids" widget="many2many_tags"/>
                            <field name="activo"/>
                        </group>
                    </group>

                    <!-- Espacio para futuras configuraciones -->
                    <group string="Configuraciones Futuras" invisible="1">
                        <!-- Aquí podrás agregar más campos -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>