<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción de ventana -->
    <record id="action_reporte_modulo" model="ir.actions.act_window">
        <field name="name">Reportes</field>
        <field name="res_model">reporte.modulo</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer reporte
            </p>
            <p>
                Puedes crear reportes, guardarlos como borradores
                o culminarlos cuando estén terminados.
            </p>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="view_reporte_modulo_kanban" model="ir.ui.view">
        <field name="name">reporte.modulo.kanban</field>
        <field name="model">reporte.modulo</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="codigo"/>
                <field name="titulo"/>
                <field name="estado"/>
                <field name="usuario_id"/>
                <field name="fecha"/>
                <field name="area_ids"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('res.users', 'image_128', record.usuario_id.raw_value)"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="codigo"/> - <field name="titulo"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="usuario_id"/>
                                    <span class="oe_kanban_list_many2many">
                                        <field name="area_ids"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="estado"/>
                                </div>
                                <div class="o_kanban_footer">
                                    <field name="fecha"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Tree -->
    <record id="view_reporte_modulo_tree" model="ir.ui.view">
        <field name="name">reporte.modulo.tree</field>
        <field name="model">reporte.modulo</field>
        <field name="arch" type="xml">
            <tree string="Reportes">
                <field name="codigo"/>
                <field name="titulo"/>
                <field name="fecha"/>
                <field name="usuario_id"/>
                <field name="area_ids" widget="many2many_tags"/>
                <field name="estado" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_reporte_modulo_form" model="ir.ui.view">
        <field name="name">reporte.modulo.form</field>
        <field name="model">reporte.modulo</field>
        <field name="arch" type="xml">
            <form string="Reporte">
                <header>
                    <button name="action_guardar_borrador"
                            type="object"
                            string="Guardar Borrador"
                            class="btn-secondary"
                            attrs="{'invisible': [('estado', '!=', 'borrador')]}"/>

                    <button name="action_guardar"
                            type="object"
                            string="Guardar"
                            class="btn-primary"
                            attrs="{'invisible': [('estado', '!=', 'borrador')]}"/>

                    <button name="action_culminar"
                            type="object"
                            string="Culminar"
                            class="btn-success"
                            attrs="{'invisible': [('estado', 'in', ['culminado', 'enviado'])]}"/>

                    <button name="action_borrador"
                            type="object"
                            string="Volver a Borrador"
                            class="btn-warning"
                            confirm="¿Estás seguro de volver a borrador?"
                            attrs="{'invisible': [('estado', 'in', ['borrador', 'enviado'])]}"/>

                    <button name="action_enviar"
                            type="object"
                            string="Enviar"
                            class="btn-danger"
                            confirm="¿Confirmas el envío del reporte?"
                            attrs="{'invisible': [('estado', 'in', ['borrador', 'enviado'])]}"/>

                    <field name="estado"
                           widget="statusbar"
                           statusbar_visible="borrador,guardado,culminado,enviado"
                           readonly="1"/>
                </header>
                <sheet>
                    <!-- Ribbons -->
                    <widget name="web_ribbon"
                            title="Borrador"
                            bg_color="bg-secondary"
                            attrs="{'invisible': [('estado', '!=', 'borrador')]}"/>
                    <widget name="web_ribbon"
                            title="Guardado"
                            bg_color="bg-primary"
                            attrs="{'invisible': [('estado', '!=', 'guardado')]}"/>
                    <widget name="web_ribbon"
                            title="Culminado"
                            bg_color="bg-success"
                            attrs="{'invisible': [('estado', '!=', 'culminado')]}"/>
                    <widget name="web_ribbon"
                            title="Enviado"
                            bg_color="bg-danger"
                            attrs="{'invisible': [('estado', '!=', 'enviado')]}"/>

                    <div class="oe_title">
                        <h1>
                            <field name="titulo" placeholder="Título del reporte..."
                                   attrs="{'readonly': [('estado', '=', 'enviado')]}"/>
                        </h1>
                        <div class="o_row">
                            <div class="o_group o_group_2">
                                <div class="o_row">
                                    <field name="codigo" readonly="1"/>
                                </div>
                                <div class="o_row">
                                    <field name="fecha"
                                           attrs="{'readonly': [('estado', '=', 'enviado')]}"/>
                                </div>
                                <div class="o_row">
                                    <field name="usuario_id" readonly="1"/>
                                </div>
                                <div class="o_row">
                                    <field name="area_ids" 
                                           widget="many2many_tags"
                                           placeholder="Áreas asignadas automáticamente"
                                           readonly="1"
                                           force_save="0"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <notebook>
                        <page string="Contenido">
                            <field name="contenido" widget="html"
                                   attrs="{'readonly': [('estado', '=', 'enviado')]}"/>
                        </page>
                        <page string="Información">
                            <group>
                                <group>
                                    <field name="create_date" readonly="1"/>
                                    <field name="create_uid" readonly="1"/>
                                    <field name="fecha_borrador" readonly="1"/>
                                </group>
                                <group>
                                    <field name="write_date" readonly="1"/>
                                    <field name="write_uid" readonly="1"/>
                                    <field name="fecha_guardado" readonly="1"/>
                                    <field name="fecha_culminado" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Búsqueda/Filtros -->
    <record id="view_reporte_modulo_search" model="ir.ui.view">
        <field name="name">reporte.modulo.search</field>
        <field name="model">reporte.modulo</field>
        <field name="arch" type="xml">
            <search>
                <field name="titulo" filter_domain="['|', ('titulo','ilike',self), ('contenido','ilike',self)]"/>
                <field name="codigo"/>
                <field name="usuario_id"/>
                <field name="area_ids"/>
                <filter name="estado_borrador" string="Borrador" domain="[('estado','=','borrador')]"/>
                <filter name="estado_guardado" string="Guardado" domain="[('estado','=','guardado')]"/>
                <filter name="estado_culminado" string="Culminado" domain="[('estado','=','culminado')]"/>
                <filter name="estado_enviado" string="Enviado" domain="[('estado','=','enviado')]"/>
                <separator/>
                <filter name="mis_reportes" string="Mis Reportes" domain="[('usuario_id','=',uid)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_estado" string="Estado" context="{'group_by':'estado'}"/>
                    <filter name="group_usuario" string="Usuario" context="{'group_by':'usuario_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>