<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_reporte_area" model="ir.actions.act_window">
        <field name="name">Áreas</field>
        <field name="res_model">reporte.area</field>
        <field name="view_mode">tree,form</field>
        <!-- Elimina esta línea: <field name="view_id" ref="view_reporte_area_tree"/> -->
    </record>

    <record id="view_reporte_area_tree" model="ir.ui.view">
        <field name="name">reporte.area.tree</field>
        <field name="model">reporte.area</field>
        <field name="arch" type="xml">
            <tree string="Áreas">
                <field name="nombre"/>
                <field name="descripcion"/>
                <field name="activo"/>
            </tree>
        </field>
    </record>

    <record id="view_reporte_area_form" model="ir.ui.view">
        <field name="name">reporte.area.form</field>
        <field name="model">reporte.area</field>
        <field name="arch" type="xml">
            <form string="Área">
                <sheet>
                    <group>
                        <group>
                            <field name="nombre" readonly="1"/>
                            <field name="descripcion" readonly="1"/>
                        </group>
                        <group>
                            <field name="activo" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>