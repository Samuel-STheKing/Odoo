<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Reglas para reportes -->
        <record id="rule_reporte_all" model="ir.rule">
            <field name="name">Todos pueden acceder a reportes</field>
            <field name="model_id" search="[('model','=','reporte.modulo')]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Reglas para áreas -->
        <record id="rule_area_all" model="ir.rule">
            <field name="name">Todos pueden ver áreas</field>
            <field name="model_id" search="[('model','=','reporte.area')]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Reglas para configuración -->
        <record id="rule_config_all" model="ir.rule">
            <field name="name">Todos pueden acceder a configuración</field>
            <field name="model_id" search="[('model','=','reporte.config')]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
