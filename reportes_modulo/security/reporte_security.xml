<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categoría -->
    <record id="module_category_gestion_reportes" model="ir.module.category">
        <field name="name">Gestión de Reportes</field>
        <field name="sequence">15</field>
    </record>

    <!-- Grupos -->
    <record id="group_reporte_lector" model="res.groups">
        <field name="name">Lector</field>
        <field name="category_id" ref="module_category_gestion_reportes"/>
    </record>

    <record id="group_reporte_editor" model="res.groups">
        <field name="name">Editor</field>
        <field name="category_id" ref="module_category_gestion_reportes"/>
        <field name="implied_ids" eval="[(4, ref('group_reporte_lector'))]"/>
    </record>

    <record id="group_reporte_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="category_id" ref="module_category_gestion_reportes"/>
        <field name="implied_ids" eval="[(4, ref('group_reporte_editor'))]"/>
    </record>

    <record id="group_reporte_administrador" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_gestion_reportes"/>
        <field name="implied_ids" eval="[(4, ref('group_reporte_supervisor'))]"/>
    </record>

    <!-- Reglas de Seguridad -->
    <data noupdate="1">
        <!-- Reportes -->
        <record id="rule_reporte_admin" model="ir.rule">
            <field name="name">Reportes - Admin Total</field>
            <field name="model_id" search="[('model','=','reporte.modulo')]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_reporte_administrador'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_reporte_user" model="ir.rule">
            <field name="name">Reportes - Usuarios Normales</field>
            <field name="model_id" search="[('model','=','reporte.modulo')]"/>
            <field name="domain_force">
                ['|', ('usuario_id', '=', user.id), ('area_ids', 'in', user.reporte_area_ids.ids)]
            </field>
            <field name="groups" eval="[(4, ref('group_reporte_lector'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Configuración - BLOQUEAR COMPLETAMENTE PARA USUARIOS NORMALES -->
        <record id="rule_reporte_config_read" model="ir.rule">
            <field name="name">Config - Sin acceso para no administradores</field>
            <field name="model_id" search="[('model','=','reporte.config')]"/>
            <field name="domain_force">[(0, '=', 1)]</field>  <!-- ✅ Domain que siempre retorna False -->
            <field name="groups" eval="[(4, ref('group_reporte_lector'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Configuración - Solo Admin puede gestionar -->
        <record id="rule_reporte_config_admin" model="ir.rule">
            <field name="name">Config - Admin Total</field>
            <field name="model_id" search="[('model','=','reporte.config')]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_reporte_administrador'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Áreas -->
        <record id="rule_area_read" model="ir.rule">
            <field name="name">Áreas - Lectura General</field>
            <field name="model_id" search="[('model','=','reporte.area')]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_reporte_lector'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_area_admin" model="ir.rule">
            <field name="name">Áreas - Admin</field>
            <field name="model_id" search="[('model','=','reporte.area')]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_reporte_administrador'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>