<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== ACCIONES ==================== -->

    <!-- Acción principal del menú Manuales: muestra los módulos en kanban -->
    <record id="action_modulo_categoria" model="ir.actions.act_window">
        <field name="name">Módulos</field>
        <field name="res_model">modulo.categoria</field>
        <field name="view_mode">kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay módulos disponibles
            </p>
            <p>Contacte al administrador para crear módulos de documentación.</p>
        </field>
    </record>

    <!-- Acción para el menú Inducciones -->
    <record id="action_inducciones" model="ir.actions.act_window">
        <field name="name">Inducciones</field>
        <field name="res_model">documentacion.manual</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('es_induccion','=',True)]</field>
    </record>

    <!-- Acción usada en el formulario de módulo para crear/vincular manuales -->
    <record id="action_documentacion" model="ir.actions.act_window">
        <field name="name">Manuales</field>
        <field name="res_model">documentacion.manual</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay manuales en este módulo
            </p>
            <p>Cree el primer manual haciendo clic en "Nuevo".</p>
        </field>
    </record>

    <!-- Acción de Configuración (solo administradores): gestión de módulos -->
    <record id="action_config_documentacion" model="ir.actions.act_window">
        <field name="name">Módulos de Documentación</field>
        <field name="res_model">modulo.categoria</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay módulos creados
            </p>
            <p>Cree módulos (Ventas, Compras, etc.) para organizar los manuales.</p>
        </field>
    </record>

    <!-- ==================== VISTAS DE MANUALES ==================== -->

    <record id="view_documentacion_search" model="ir.ui.view">
        <field name="name">documentacion.manual.search</field>
        <field name="model">documentacion.manual</field>
        <field name="arch" type="xml">
            <search>
                <field name="titulo" placeholder="Buscar por título..."/>
                <field name="categoria_id" placeholder="Filtrar por módulo..."/>
                <filter name="induccion" string="Solo Inducciones" domain="[('es_induccion','=',True)]"/>
                <filter name="culminado" string="Culminados" domain="[('estado','=','culminado')]"/>
                <separator/>
                <filter name="en_edicion" string="En Edición" domain="[('estado','=','en_edicion')]"
                        groups="documentacion.group_documentacion_manager"/>
                <filter name="archivados" string="Archivados"
                        domain="[('active','=',False)]"
                        context="{'active_test': False}"
                        groups="documentacion.group_documentacion_manager"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_categoria" string="Módulo" context="{'group_by':'categoria_id'}"/>
                    <filter name="group_tipo" string="Tipo" context="{'group_by':'tipo'}"/>
                    <filter name="group_estado" string="Estado" context="{'group_by':'estado'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_documentacion_tree" model="ir.ui.view">
        <field name="name">documentacion.manual.tree</field>
        <field name="model">documentacion.manual</field>
        <field name="arch" type="xml">
            <tree string="Lista de Manuales"
                  decoration-warning="estado == 'en_edicion'"
                  decoration-success="estado == 'culminado'">
                <field name="titulo" string="Título"/>
                <field name="tipo" string="Tipo" widget="badge"/>
                <field name="numero_pagina" string="Páginas"/>
                <field name="estado" string="Estado" widget="badge"/>
                <field name="es_induccion" string="Inducción"/>
                <field name="fecha_creacion" string="Fecha"/>
            </tree>
        </field>
    </record>

    <record id="view_documentacion_form" model="ir.ui.view">
        <field name="name">documentacion.manual.form</field>
        <field name="model">documentacion.manual</field>
        <field name="arch" type="xml">
            <form string="Manual">
                <header>
                    <!-- Botón visible en En Edición: guarda sin cambiar estado -->
                    <button name="action_guardar_edicion"
                            type="object"
                            string="Guardar Edición"
                            attrs="{'invisible': [('estado', '!=', 'en_edicion')]}"/>
                    <!-- Botón visible en En Edición: culmina el documento -->
                    <button name="action_culminar"
                            type="object"
                            string="Culminar"
                            class="btn-primary"
                            attrs="{'invisible': [('estado', '!=', 'en_edicion')]}"
                            groups="documentacion.group_documentacion_manager"/>
                    <!-- Botón visible solo cuando está Culminado: regresa a edición -->
                    <button name="action_en_edicion"
                            type="object"
                            string="Reabrir para Edición"
                            attrs="{'invisible': [('estado', '!=', 'culminado')]}"
                            groups="documentacion.group_documentacion_manager"/>
                    <field name="estado"
                           widget="statusbar"
                           statusbar_visible="en_edicion,culminado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="titulo" placeholder="Título del documento..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="categoria_id" required="1"
                                   options="{'no_create': False, 'create': True}"
                                   placeholder="Seleccione o cree un módulo"/>
                            <field name="tipo" widget="radio"/>
                            <field name="archivo_pdf"
                                   attrs="{'invisible': [('tipo', '!=', 'pdf')], 'required': [('tipo', '=', 'pdf')]}"
                                   filename="titulo"
                                   help="Subir archivo PDF - Tamaño máximo recomendado: 25MB"/>
                            <field name="url_video"
                                   attrs="{'invisible': [('tipo', '!=', 'video')], 'required': [('tipo', '=', 'video')]}"
                                   placeholder="https://www.youtube.com/watch?v=xxxx"/>
                            <field name="numero_pagina"/>
                        </group>
                        <group>
                            <field name="roles_ids" widget="many2many_tags"/>
                            <field name="es_induccion"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vista Previa PDF" name="vista_previa"
                              attrs="{'invisible': [('tipo', '!=', 'pdf')]}">
                            <div attrs="{'invisible': [('archivo_pdf', '=', False)]}">
                                <div class="alert alert-info text-center">
                                    <strong>PDF cargado:</strong> <field name="titulo"/> — <field name="numero_pagina"/> páginas
                                </div>
                                <field name="archivo_pdf"
                                       widget="pdf_viewer"
                                       nolabel="1"
                                       style="width: 100%; height: 600px; display: block;"
                                       attrs="{'invisible': ['|', ('archivo_pdf', '=', False), ('id', '=', False)]}"/>
                                <div attrs="{'invisible': [('archivo_pdf', '!=', False), ('id', '!=', False)]}"
                                     style="color: #666; text-align: center; padding: 80px 20px; border: 1px solid #e0e0e0; border-radius: 4px; background: #f9f9f9;">
                                    <p>Guarde el registro para visualizar la vista previa del PDF.</p>
                                </div>
                            </div>
                            <div class="text-center" attrs="{'invisible': [('archivo_pdf', '!=', False)]}">
                                <p class="text-muted">No hay archivo PDF cargado.</p>
                            </div>
                        </page>

                        <page string="Vista Previa Video" name="vista_previa_video"
                              attrs="{'invisible': [('tipo', '!=', 'video')]}">
                            <div attrs="{'invisible': [('url_video', '=', False)]}">
                                <div class="alert alert-info text-center">
                                    <strong>Video:</strong> <field name="titulo"/>
                                    <br/>
                                    <strong>URL:</strong> <field name="url_video"/>
                                </div>
                                <field name="youtube_embed_html"
                                       widget="html"
                                       nolabel="1"
                                       readonly="1"
                                       sanitize="false"/>
                            </div>
                            <div class="text-center" attrs="{'invisible': [('url_video', '!=', False)]}">
                                <p class="text-muted">No hay URL de video cargada.</p>
                                <p class="text-info">Formatos soportados: youtube.com/watch?v=... · youtu.be/... · youtube.com/shorts/...</p>
                            </div>
                        </page>

                        <page string="Descripción" name="descripcion">
                            <field name="descripcion" widget="html"
                                   placeholder="Descripción detallada del contenido del manual..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ==================== VISTAS DE MÓDULOS ==================== -->

    <!-- Kanban principal: clic en la tarjeta abre la lista de manuales del módulo -->
    <record id="view_modulo_categoria_kanban" model="ir.ui.view">
        <field name="name">modulo.categoria.kanban</field>
        <field name="model">modulo.categoria</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="nombre"/>
                <field name="descripcion"/>
                <field name="cantidad_manuales"/>
                <field name="activo"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card" style="padding: 0; cursor: pointer;">
                            <button type="object" name="action_ver_manuales"
                                    class="btn btn-link text-reset text-decoration-none w-100 text-start p-3"
                                    style="border: none; background: none;">
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-folder-open-o me-3 flex-shrink-0"
                                       style="font-size: 40px; color: #7c7bad;"/>
                                    <div>
                                        <strong class="o_kanban_record_title d-block">
                                            <field name="nombre"/>
                                        </strong>
                                        <div class="text-muted small">
                                            <field name="descripcion" nolabel="1"/>
                                        </div>
                                        <span class="badge rounded-pill text-bg-primary mt-1">
                                            <field name="cantidad_manuales"/> manuales
                                        </span>
                                    </div>
                                </div>
                            </button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Lista de módulos (usada en Configuración) -->
    <record id="view_modulo_categoria_tree" model="ir.ui.view">
        <field name="name">modulo.categoria.tree</field>
        <field name="model">modulo.categoria</field>
        <field name="arch" type="xml">
            <tree string="Módulos de Documentación">
                <field name="nombre" string="Nombre"/>
                <field name="descripcion" string="Descripción"/>
                <field name="cantidad_manuales" string="Total Manuales" sum="Total"/>
                <field name="group_ids" string="Aplicaciones con Acceso" widget="many2many_tags"/>
                <field name="activo" string="Activo"/>
            </tree>
        </field>
    </record>

    <!-- Formulario de módulo (accesible solo desde Configuración) -->
    <record id="view_modulo_categoria_form" model="ir.ui.view">
        <field name="name">modulo.categoria.form</field>
        <field name="model">modulo.categoria</field>
        <field name="arch" type="xml">
            <form string="Módulo de Documentación">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="nombre" placeholder="Nombre del Módulo..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Información General">
                            <field name="descripcion" placeholder="Descripción del módulo"/>
                            <field name="activo"/>
                            <field name="cantidad_manuales" readonly="1"/>
                        </group>
                        <group string="Control de Acceso">
                            <field name="group_ids"
                                   widget="many2many_tags"
                                   domain="[('category_id', '!=', False)]"
                                   options="{'no_create': True, 'no_quick_create': True}"
                                   help="Grupos de Odoo que pueden ver este módulo. Si está vacío, todos los usuarios de documentación pueden verlo."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Manuales del Módulo" name="manuales">
                            <field name="manual_ids" nolabel="1" readonly="1">
                                <tree string="Manuales"
                                      create="false"
                                      edit="false"
                                      delete="false"
                                      decoration-warning="estado == 'en_edicion'"
                                      decoration-success="estado == 'culminado'">
                                    <field name="titulo" string="Título"/>
                                    <field name="tipo" string="Tipo" widget="badge"/>
                                    <field name="numero_pagina" string="Páginas"/>
                                    <field name="estado" string="Estado" widget="badge"/>
                                    <field name="es_induccion" string="Inducción"/>
                                    <field name="fecha_creacion" string="Fecha Creación"/>
                                </tree>
                            </field>
                            <div class="text-center mt-3">
                                <button name="%(action_documentacion)d"
                                        type="action"
                                        string="Nuevo Manual"
                                        class="btn btn-primary"
                                        context="{'default_categoria_id': active_id}"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>