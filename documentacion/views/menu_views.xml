<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú principal DOCUMENTACIÓN -->
    <menuitem id="menu_documentacion_root" 
              name="Documentación" 
              sequence="10"/>

    <!-- Menú Manuales (principal) - Muestra los módulos -->
    <menuitem id="menu_documentacion_modulos" 
              name="Manuales" 
              parent="menu_documentacion_root" 
              action="action_wsl_modulo_categoria"
              sequence="5"/>

    <!-- Menú Inducciones - Muestra solo documentos de inducción -->
    <menuitem id="menu_documentacion_inducciones" 
              name="Inducciones" 
              parent="menu_documentacion_root" 
              action="action_wsl_inducciones"
              sequence="20"/>

    <!-- Submenú Configuración -->
    <menuitem id="menu_documentacion_configuracion" 
              name="Configuración" 
              parent="menu_documentacion_root" 
              sequence="30"/>

    <!-- Opciones dentro de Configuración -->
    <menuitem id="menu_config_modulos" 
              name="Configuración de Módulos" 
              parent="menu_documentacion_configuracion"
              action="action_config_modulos"
              sequence="10"/>

    <menuitem id="menu_config_roles" 
              name="Configuración de Roles" 
              parent="menu_documentacion_configuracion"
              action="action_config_roles"
              sequence="20"/>
</odoo>