<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú raíz -->
    <menuitem id="menu_documentacion_root"
              name="Documentación"
              sequence="10"/>

    <!-- Manuales: muestra kanban de módulos -->
    <menuitem id="menu_documentacion_modulos"
              name="Manuales"
              parent="menu_documentacion_root"
              action="action_modulo_categoria"
              sequence="5"/>

    <!-- Inducciones -->
    <menuitem id="menu_documentacion_inducciones"
              name="Inducciones"
              parent="menu_documentacion_root"
              action="action_inducciones"
              sequence="20"/>

    <!-- Configuración: solo visible para administradores -->
    <menuitem id="menu_documentacion_configuracion"
              name="Configuración"
              parent="menu_documentacion_root"
              groups="documentacion.group_documentacion_manager"
              sequence="30"/>

    <menuitem id="menu_config_documentacion"
              name="Módulos"
              parent="menu_documentacion_configuracion"
              action="action_config_documentacion"
              groups="documentacion.group_documentacion_manager"
              sequence="10"/>
</odoo>
