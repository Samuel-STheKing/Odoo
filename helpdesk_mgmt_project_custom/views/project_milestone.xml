<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Form View (sin cambios) -->
    <record model="ir.ui.view" id="project_milestone_form_view">
        <field name="model">project.milestone</field>
        <field name="inherit_id" ref="project.project_milestone_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_helpdesk_ticket"
                    type="object"
                    title="View Tickets"
                    string="View Tickets"
                    class="oe_stat_button"
                    icon="fa-ticket"
                    groups="helpdesk_mgmt.group_helpdesk_user_own"
                    attrs="{'invisible': [('helpdesk_ticket_count', '=', 0)]}"
                >
                    <div class="o_field_widget o_stat_info">
                        <field
                            name="helpdesk_ticket_count"
                            widget="statinfo"
                            string="Tickets"
                        />
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Tree View - CORREGIDO -->
    <record model="ir.ui.view" id="project_milestone_tree_view">
        <field name="model">project.milestone</field>
        <field name="inherit_id" ref="project.project_milestone_view_tree" />
        <field name="arch" type="xml">
            
            <!-- Botón adicional -->
            <button name="action_view_tasks" position="after">
                <button
                    name="action_view_helpdesk_ticket"
                    type="object"
                    title="View Helpdesk Tickets"
                    string="View Helpdesk Tickets"
                    class="btn btn-link float-end"
                    attrs="{'invisible': [('helpdesk_ticket_count', '=', 0)]}"
                    groups="helpdesk_mgmt.group_helpdesk_user_own"
                />
            </button>

            <!-- Campo requerido para el attrs - AÑADIDO DENTRO DE LA VISTA TREE -->
            <xpath expr="//tree" position="inside">
                <field name="helpdesk_ticket_count" invisible="1"/>
            </xpath>

        </field>
    </record>

</odoo>